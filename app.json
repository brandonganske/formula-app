{
  "expo": {
    "name": "Formula",
    "slug": "formula-creators",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "formula",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.influenceish.formula",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.influenceish.formula",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FF4B5C"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FF7A45",
          "iosDisplayInForeground": true
        }
      ],
      [
        "./modules/tiktok-login/app.plugin.js",
        {
          "clientKey": "awe42sltxt0xs2ng",
          "universalLinkDomains": [
            "iq.influenceish.com"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Formula uses your photo library so you can check a video for TikTok Shop policy risks before you post it."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Formula uses the camera so you can film while reading your script.",
          "microphonePermission": "Formula uses the microphone to record your takes.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Formula saves your takes to your photo library.",
          "savePhotosPermission": "Formula saves your takes to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-video",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "iosShareExtensionName": "Formula",
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dd169693-d17c-4743-9ac9-4b7bbf2fc5fc"
      }
    },
    "owner": "influenceish",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dd169693-d17c-4743-9ac9-4b7bbf2fc5fc"
    }
  }
}
